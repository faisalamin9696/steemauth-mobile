# Copy to .env and fill in.

# Supabase project for device-side data (activity sync, revocation watch).
#
# NOTE: session messaging needs NO endpoint here in protocol v3 — every QR
# carries its own relay URL/room/token (`rt`/`rm`/`tk`) and both peers follow
# it. The relay (`wss://relay.steempro.com`) IS the message plane in v3
# (token-authenticated rooms) and needs no env var on this side.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
