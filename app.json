{
  "expo": {
    "name": "SteemAuth",
    "slug": "SteemAuth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "steemauth",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.steempro.authenticator",
      "infoPlist": {
        "NSCameraUsageDescription": "SteemAuth uses the camera to scan QR codes generated by applications that want to request Steem actions.",
        "NSFaceIDUsageDescription": "Allow SteemAuth to use Face ID to unlock your keys and approve Steem operations."
      }
    },
    "android": {
      "package": "com.steempro.authenticator",
      "versionCode": 4,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B2A6B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2A6B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "SteemAuth uses the camera to scan QR codes generated by applications that want to request Steem actions."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SteemAuth to use Face ID to unlock your keys and approve Steem operations."
        }
      ],
      "./plugins/with-android-mlkit-keep-rules",
      "./plugins/with-android-remove-unused-permissions",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d7a5a605-85cf-44ef-afc4-4c7434640157"
      }
    },
    "owner": "faisalamin9696"
  }
}
